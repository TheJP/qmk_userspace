ENCODER_MAP_ENABLE = yes

# Enables us to use encoders to scroll and move the mouse and click with keys.
MOUSEKEY_ENABLE = yes

# Enables custom RGB LED effects.
RGB_MATRIX_CUSTOM_USER = yes

# Makes it easier to write all CAPS words (e.g. constants in some languages).
CAPS_WORD_ENABLE = yes

# This adds module functionality to your keyboard (files found in users/halcyon_modules)
USER_NAME := halcyon_modules

SRC += jp_util.c
